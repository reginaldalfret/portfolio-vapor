          var buttons = document.querySelectorAll('.lab-tab-btn');
          buttons.forEach(function(b) {
            b.className = 'lab-tab-btn px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-neutral-400 hover:text-white';
